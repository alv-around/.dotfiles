{
  "title": "Change caps_lock key",
  "rules": [
    {
      "description": "caps_lock -> escape (tap) / left_control (hold)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [{"key_code": "left_control"}],
          "to_if_alone": [{"key_code": "escape"}]
        }
      ]
    }
  ]
}
